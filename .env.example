NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loadwave?schema=public

# Auth — MUST be changed to long random strings in production.
JWT_ACCESS_SECRET=change-me-access-secret-please-use-32+chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32+chars
JWT_REFRESH_TTL=604800
# "Remember me" sessions live this long (seconds). Default 30 days.
JWT_REMEMBER_TTL=2592000
JWT_ISSUER=loadwave
JWT_AUDIENCE=loadwave-clients

# ELD webhook (optional; leave empty to disable the endpoint).
ELD_WEBHOOK_SECRET=change-me-eld-webhook-secret

# Optional jurisdiction rate override JSON (leave empty for built-in defaults).
IFTA_JURISDICTION_RATES=

# Email / notifications — SMTP. Leave empty to disable email (in-app alerts still work).
SMTP_URL=
MAIL_FROM=dispatch@loadwave.app

# Used by scripts/import-loads.ts CLI (set the tenant to import into).
TENANT_ID=

# Diagnostics admin key — optional; /api/diagnostics stays disabled when empty.
DIAGNOSTICS_ADMIN_KEY=
DIAGNOSTICS_KEY_FILE=

# CORS allowlist (comma-separated). Leave EMPTY when nginx serves both the app
# and the API from the same origin (recommended) — no CORS headers are sent.
# Set it only if the API is hosted on a different origin than the SPA.
CORS_ORIGIN=
# Public app URL used in emailed links (password reset, invites).
# Set to your real domain in production, e.g. https://app.loadwave.ca
APP_URL=http://localhost:5173

# Web Push (VAPID) — generate keys with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourdomain.com

# FMCSA authority verification. The web key is free (see DEPLOY_ORACLE.md).
# Leave EMPTY to disable the lookup entirely: authority status then renders as
# "self-declared" rather than claiming a check that did not happen, and the
# Verified badge stays dark. Recommended: set it, and the badge becomes real.
FMCSA_WEBKEY=
# Override only to point at a mock/staging FMCSA service (tests use this).
FMCSA_BASE_URL=

# Release marker reported by GET /api/health ({"status":"ok","version":"…"}),
# so you can confirm from outside the box which build is live. Keep it in step
# with the version in package.json.
APP_VERSION=1.0.0

# Operator key for billing administration — approving plan upgrade requests.
# Leave EMPTY to disable plan activation entirely: with no payment provider
# wired up, plans are activated out-of-band by staff holding this key, and an
# unconfigured deployment must never let anyone upgrade themselves.
BILLING_ADMIN_KEY=
